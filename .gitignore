# dependencies and build output
node_modules/
dist/
dist-ui/
dist-test/
release/
*.zip
.vite/
*.tsbuildinfo

# python caches
__pycache__/
*.pyc

# source art inputs (large; supplied separately, tools/build_art.py regenerates public/assets from them)
art/source/
art/handoff/
art/patch/

# generated test evidence that is large or regenerable
tests/logs/screens/
tests/logs/saves/
# Root-level test logs/reports and scratch captures are local run output.
# Historical root-level artifacts already tracked in Git stay as the recorded baseline.
tests/logs/*.log
tests/logs/*.json
tests/logs/*.png
tests/logs/*.jpg
# Generated contact sheets/lineups are large local review aids; the compact
# curated before/after set lives under docs/overhaul-evidence instead.
docs/art-evidence/*
!docs/art-evidence/MAP_ART_INDEX.md
tests/tmp/

# local/editor files
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log.bak
